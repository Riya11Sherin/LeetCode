class Solution:
    def letterCombinations(self, digits: str) -> list[str]:
        # Edge case: empty input string
        if not digits:
            return []
        
        # Phone keypad mapping
        phone_map = {
            '2': 'abc', '3': 'def',  '4': 'ghi',
            '5': 'jkl', '6': 'mno',  '7': 'pqrs',
            '8': 'tuv', '9': 'wxyz'
        }
        
        combinations = []
        
        def backtrack(index: int, current_path: list[str]):
            # Base case: if the combination length matches input length
            if index == len(digits):
                combinations.append("".join(current_path))
                return
            
            # Get letters corresponding to the current digit
            possible_letters = phone_map[digits[index]]
            
            for letter in possible_letters:
                current_path.append(letter)          # Explore
                backtrack(index + 1, current_path)  # Recurse
                current_path.pop()                   # Backtrack
        
        backtrack(0, [])
        return combinations
