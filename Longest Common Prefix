class Solution:
    def longestCommonPrefix(self, strs: list[str]) -> str:
        if not strs:
            return ""
        
        # Iterate through characters of the first string
        for i, char in enumerate(strs[0]):
            # Compare with the same position in all other strings
            for s in strs[1:]:
                # If we reach the end of a string or characters don't match
                if i == len(s) or s[i] != char:
                    return strs[0][:i]
                    
        return strs[0]
