class Solution:
    def longestPalindrome(self, s: str) -> str:
        if not s or len(s) < 1:
            return ""

        start, max_len = 0, 0

        def expand_around_center(left: int, right: int) -> int:
            # Expand outward as long as the characters match and bounds are valid
            while left >= 0 and right < len(s) and s[left] == s[right]:
                left -= 1
                right += 1
            # Length of palindrome found (right - left - 1 because pointers overshoot by 1)
            return right - left - 1

        for i in range(len(s)):
            # Odd-length palindromes (single-character center)
            len1 = expand_around_center(i, i)
            # Even-length palindromes (two-character center)
            len2 = expand_around_center(i, i + 1)
            
            current_max = max(len1, len2)
            
            # Update start position and max length if a longer palindrome is found
            if current_max > max_len:
                max_len = current_max
                # Calculate starting index based on center 'i' and total length
                start = i - (current_max - 1) // 2

        return s[start:start + max_len]
