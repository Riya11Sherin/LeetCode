class Solution:
    def isPalindrome(self, x: int) -> bool:
        # Negative numbers are not palindromes (e.g., -121 -> 121-)
        # Numbers ending in 0 (except 0 itself) are not palindromes (e.g., 10 -> 01)
        if x < 0 or (x % 10 == 0 and x != 0):
            return False

        reverted_number = 0
        
        # Reverse the second half of the integer
        while x > reverted_number:
            reverted_number = reverted_number * 10 + x % 10
            x //= 10

        # For even length numbers: x == reverted_number (e.g., 1221 -> x=12, reverted=12)
        # For odd length numbers: x == reverted_number // 10 (e.g., 12321 -> x=12, reverted=123)
        return x == reverted_number or x == reverted_number // 10
