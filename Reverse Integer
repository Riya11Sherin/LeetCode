class Solution:
    def reverse(self, x: int) -> int:
        # Define 32-bit signed integer boundaries
        INT_MIN, INT_MAX = -2**31, 2**31 - 1
        
        # Determine the sign and work with absolute value
        sign = -1 if x < 0 else 1
        x = abs(x)
        
        reversed_x = 0
        while x != 0:
            digit = x % 10
            x //= 10
            
            # Reconstruct the reversed number
            reversed_x = reversed_x * 10 + digit
        
        # Restore sign
        reversed_x *= sign
        
        # Check if the result exceeds 32-bit signed integer range
        if reversed_x < INT_MIN or reversed_x > INT_MAX:
            return 0
            
        return reversed_x
