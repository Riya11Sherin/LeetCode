class Solution:
    def threeSumClosest(self, nums: list[int], target: int) -> int:
        # Step 1: Sort the array to enable the two-pointer strategy
        nums.sort()
        
        # Initialize closest_sum with the sum of the first three numbers
        closest_sum = nums[0] + nums[1] + nums[2]
        
        # Step 2: Iterate through the array
        for i in range(len(nums) - 2):
            left = i + 1
            right = len(nums) - 1
            
            while left < right:
                current_sum = nums[i] + nums[left] + nums[right]
                
                # If current_sum is closer to target than our recorded closest_sum, update it
                if abs(current_sum - target) < abs(closest_sum - target):
                    closest_sum = current_sum
                
                # Adjust pointers based on current_sum relative to target
                if current_sum < target:
                    left += 1  # Need a larger sum
                elif current_sum > target:
                    right -= 1  # Need a smaller sum
                else:
                    # Exact match found, distance is 0, so return target immediately
                    return current_sum
                    
        return closest_sum
